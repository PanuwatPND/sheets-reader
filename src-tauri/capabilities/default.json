{
  "$schema": "https://schema.tauri.app/schema/2/capability.json",
  "identifier": "default",
  "description": "Default capability for Sheets Reader",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-is-visible",
    "core:tray:default",
    "core:menu:default",
    "core:event:default",
    "dialog:default"
  ]
}
